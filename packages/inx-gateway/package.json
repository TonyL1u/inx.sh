{
  "name": "@inx.sh/gateway",
  "version": "0.1.0-beta.0",
  "description": "HTTPS gateway for managing a local 3x-ui panel from INX Connect",
  "type": "module",
  "bin": {
    "inx-gateway": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/install-panel.sh"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyL1u/inx.sh.git",
    "directory": "packages/inx-gateway"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js serve",
    "test": "pnpm run build && node --test tests/gateway.test.mjs",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fastify": "^5.0.0"
  }
}
