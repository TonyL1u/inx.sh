{
  "name": "@inx.sh/gateway",
  "version": "0.1.0-beta.5",
  "description": "HTTPS gateway for managing a local 3x-ui panel from INX Connect",
  "type": "module",
  "bin": {
    "inx-gateway": "dist/index.js"
  },
  "exports": {
    "./protocol": {
      "inx-source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/install-panel.sh",
    "scripts/xui-domain.sh"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TonyL1u/inx.sh.git",
    "directory": "packages/inx-gateway"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:release": "bash scripts/build-linux-bundle.sh",
    "release": "bash scripts/release.sh",
    "typecheck": "pnpm run build && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "dev": "tsx src/index.ts",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fastify": "^5.0.0"
  }
}
